# Copy to .env

# Database
DATABASE_URL=sqlite:///./app.db

# Gmail OAuth files
GOOGLE_CLIENT_SECRET_FILE=./client_secret.json
GOOGLE_TOKEN_FILE=./gmail_token.json
GMAIL_USER_ID=me

# Gmail polling query (tune later)
GMAIL_SEARCH_QUERY=in:inbox newer_than:3m
GMAIL_MAX_RESULTS_PER_POLL=100

# Job detection thresholds (heuristic)
JOB_DETECTOR_MIN_SCORE=12
JOB_CLASSIFIER_MIN_CONFIDENCE=0.35

# Noise reduction
# Comma-separated domains; if sender domain ends with any value, score gets penalized.
SENDER_DOMAIN_BLACKLIST=spotify.com,mailchimp.com,mailerlite.com,newsletter
SUBJECT_NOISE_KEYWORDS=unsubscribe,newsletter,deal,discount,promo

# Local LLM (Ollama)
USE_LLM=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Automation
FOLLOWUP_AFTER_DAYS_NO_RESPONSE=10

